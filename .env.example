# Google Sheets -> File -> Share -> Publish to web -> tab "Fix Schedule" -> CSV -> copy link
SCHEDULE_CSV_URL=

# Opsional: tab kedua berisi kolom Name,Photo
TEACHERS_CSV_URL=

# Opsional: WORKSHOP badge di IG story dari cell yang di-highlight pink di Sheet.
# Warna cell nggak ada di CSV, jadi butuh Sheets API v4 (bukan publish-to-web link):
# 1. Google Cloud Console -> buat/pilih project -> enable "Google Sheets API"
# 2. Credentials -> Create API key -> GOOGLE_SHEETS_API_KEY
# 3. ID di URL Sheet: docs.google.com/spreadsheets/d/<INI>/edit -> SCHEDULE_SHEET_ID
# 4. Sheet harus di-share "Anyone with the link" (Viewer), bukan cuma publish-to-web
GOOGLE_SHEETS_API_KEY=
SCHEDULE_SHEET_ID=
# Opsional, kalau spreadsheet punya lebih dari satu tab dan bukan yang pertama:
SCHEDULE_SHEET_NAME=
